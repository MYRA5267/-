# Telegram
TELEGRAM_BOT_TOKEN=123456:AA...

# Supabase Postgres.
# DATABASE_URL — владелец схемы (postgres). Используется ТОЛЬКО для миграций
# и для bootstrap пользователя, которого ещё нет в базе.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Все запросы от имени человека идут через тот же пул, но внутри транзакции
# с `set local role authenticated` + `app.tg_id` — то есть под RLS.

# Локальная разработка без Telegram: подставить фейковый tg_id.
# В production игнорируется полностью.
OBA_DEV_TG_ID=
OBA_ALLOW_DEV_AUTH=0

# ─────────────────────────────────────────────────────────────
# PULSE Studio
# ─────────────────────────────────────────────────────────────

# Модель. Без ключа продукт работает: версии собираются как раскладка
# идеи по формату площадки, и приложение честно это показывает.
ANTHROPIC_API_KEY=
PULSE_AI_MODEL=claude-opus-5

# Ключ шифрования токенов площадок: 32 байта (64 hex или 44 base64).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PULSE_TOKEN_KEY=

# Служебный секрет очереди: им подписан вызов /api/pulse/worker.
PULSE_WORKER_SECRET=
PULSE_BASE_URL=http://localhost:3000

# Локальная разработка без Telegram. В production выключено жёстко.
PULSE_ALLOW_DEV_AUTH=0
PULSE_DEV_TG_ID=
PULSE_DEV_NAME=

# Секрет webhook'а бота: им Telegram подписывает каждое обновление.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PULSE_TELEGRAM_WEBHOOK_SECRET=

# Планировщик Vercel подписывает свои вызовы этим секретом.
# Нужен только при деплое на Vercel; свой worker обходится PULSE_WORKER_SECRET.
CRON_SECRET=
