# Telegram
TELEGRAM_BOT_TOKEN=123456:AA...

# Supabase Postgres.
# DATABASE_URL — владелец схемы (postgres). Используется ТОЛЬКО для миграций
# и для bootstrap пользователя, которого ещё нет в базе.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Все запросы от имени человека идут через тот же пул, но внутри транзакции
# с `set local role authenticated` + `app.tg_id` — то есть под RLS.

# Локальная разработка без Telegram: подставить фейковый tg_id.
# В production игнорируется полностью.
OBA_DEV_TG_ID=
OBA_ALLOW_DEV_AUTH=0
