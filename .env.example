# Telegram
TELEGRAM_BOT_TOKEN=123456:AA...

# Postgres. Проект на Neon, но код провайдер-агностичен: обычный `pg`,
# RLS — чистый Postgres. Подойдёт любой хостинг, где можно создать роль.
#
# Берём pooled-строку (…-pooler.…): всё, что делает приложение, живёт
# внутри одной транзакции, поэтому transaction pooling безопасен.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Все запросы от имени человека идут через тот же пул, но внутри транзакции
# с `set local role authenticated` + `app.tg_id` — то есть под RLS.

# TLS проверяется всегда. Отключать только для хостингов с самоподписанным
# CA (прямое подключение к Supabase). Neon этого не требует.
PGSSL_NO_VERIFY=0

# Локальная разработка без Telegram: подставить фейковый tg_id.
# В production игнорируется полностью.
OBA_DEV_TG_ID=
OBA_ALLOW_DEV_AUTH=0
